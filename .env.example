# Where clipped notes are written on YOUR machine.
#   Linux / macOS:  VAULT_PATH=/home/you/notes
#   Windows:        VAULT_PATH=D:/notes        (forward slashes)
#   WSL2:           VAULT_PATH=/mnt/d/notes
VAULT_PATH=/absolute/path/to/your/notes

# Shared secret between the extension and the server.
# Generate one:  python -c "import secrets;print(secrets.token_urlsafe(32))"
# Leave blank to disable auth (fine, since the port is localhost-only).
CLIP_TOKEN=

# Port on 127.0.0.1. Change it if 8765 is taken.
CLIP_PORT=8765

# Port for the optional web frontend.
FRONTEND_PORT=3000

# PostgreSQL is only available inside Docker. Change the password for anything
# beyond a local-only installation. Existing database volumes keep the
# credentials they were created with.
POSTGRES_DB=clipstack
POSTGRES_USER=clipstack
POSTGRES_PASSWORD=clipstack

# MinerU OCR runs in its own GPU container on the shared local-ai network.
# OCR failures are non-fatal: the image is kept and the clip still saves.
OCR_ENABLED=true
OCR_BASE_URL=http://mineru-ocr:8766
OCR_API_KEY=
OCR_TIMEOUT=300
OCR_MAX_IMAGES=10
OCR_MIN_IMAGE_BYTES=4096
OCR_IMAGE_ANALYSIS=false

# Linux only: makes clipped files owned by you instead of root.
#   Find yours with:  id -u   and   id -g
# Ignored on Docker Desktop for Windows and macOS.
PUID=1000
PGID=1000

TZ=UTC
CLIP_LOG_LEVEL=INFO
